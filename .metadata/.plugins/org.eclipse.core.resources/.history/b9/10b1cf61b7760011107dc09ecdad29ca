#include "stm32f4xx_hal.h"
#include "stm32f4xx_hal_gpio.h"
#include "stm32f4xx_hal_uart.h"
#include <string.h>

//Here we will be using USART for the first time
//We know that USART has a TX and RX Pin(Refer to Notebook)

//1)FIND WHICH CLOCK WE NEED TO ENABLE (LIFT CLOCK GATE)
//If we look on the data-sheet of the STM32f446 and the clock diagram, we see that USART2 is the only USART Bus connected to USB
//We also see that this USART2 Bus is connected to the APB1 45Mhz Clock


//2)Find which GPIO PINS HAVE USART2 as their ALTERNATE FUNCTION
//We have to look at the stm32f446 datasheet to find this under ALTERATE FUNCTIONS, and we see that PA2 and PA3 are under AF7

void SysTick_Handler(void)
{
	HAL_IncTick();
	}


//Making the properties of our UART Module, Initializing it here so that we can use this struct to transmit messages later on
//Global variable so that usart_init() and main() can use/edit the struct

UART_HandleTypeDef UART_InitStruct = {0};





//Initializing USART Function
void usart_init(void)
{

	//enable GPIO Pin Clock for Port A(Has alterative functio for USART2)
	__HAL_RCC_GPIOA_CLK_ENABLE();



	//enable UART Module Clock(This command can be found in HAL documentation)
	__HAL_RCC_USART2_CLK_ENABLE();


	//Make Definition Struct for GPIO Pins A3 and A2

	GPIO_InitTypeDef GPIO_InitStruct = {0};
	GPIO_InitStruct.Pin = GPIO_PIN_2;
	GPIO_InitStruct.Mode = GPIO_MODE_AF_PP;
	GPIO_InitStruct.Alternate = GPIO_AF7_USART2;
	GPIO_InitStruct.Pull = GPIO_NOPULL;
	GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_VERY_HIGH;

	//Initialize RX and TX PINS

	//Pin A2 Initialized
	HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);

	//Pin A3 Initialized
	GPIO_InitStruct.Pin = GPIO_PIN_3;
	HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);



	//Configure UART -  WE USE HANDLETYPEDEF instead of INITTYPEDEF because HANDLE has more variables in its structure, and it also has the inittypdef strcuture inside of it
	//Handle Type Def also allows us to set USART Instance to whatever number we would like to set it to, in our case it would be USART2

	UART_InitStruct.Instance = USART2;
	UART_InitStruct.Init.BaudRate = 115200;
	UART_InitStruct.Init.WordLength = UART_WORDLENGTH_8B;
	UART_InitStruct.Init.StopBits = UART_STOPBITS_1;
	UART_InitStruct.Init.Parity = UART_PARITY_NONE;
	UART_InitStruct.Init.Mode = UART_MODE_TX;
	UART_InitStruct.Init.HwFlowCtl = UART_HWCONTROL_NONE;
	UART_InitStruct.Init.OverSampling = UART_OVERSAMPLING_16;


	//Initialize UART with selected properties
	HAL_UART_Init(&UART_InitStruct);

	//We have made a Trasmitting UART Module that only transmits and does not receive












	}




int main()
{
	HAL_Init();
	usart_init();

	char message[20]= "Hello Baka Baka \r\n";


	while(1)
	{

		HAL_UART_Transmit(&UART_InitStruct,(uint8_t *) message, 20, 100);

		//This is the transmit function used to transmit messages
		//These are the parameters
		//1. HandleTypeDef UART Struct with all of the properties we set
		//2. An 8 bit integer message
		//3. Size of our message,(in our case, 20 characters)
		//4. Amount of milliseconds before message times out

		HAL_Delay(10);




	}
	}
