int main()
{
	HAL_Init();
	/* USER CODE BEGIN 2 */

	// Initialize everything
	SystemClock_Config();
	MX_GPIO_Init();
	MX_TIM1_Init();
	MX_USART2_Init();

	// Start PWM on both channels
	HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);  // servo
	HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);  // ESC

	// Arm ESC — send neutral for 3 seconds
	__HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 1500);  // servo center
	__HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 1500);  // ESC neutral
	HAL_Delay(3000);

	/* USER CODE END 2 */



	/* USER CODE BEGIN WHILE */
	while (1) {

	    // Steer left
	    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 1200);
	    HAL_Delay(1000);

	    // Steer right
	    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 1800);
	    HAL_Delay(1000);

	    // Center
	    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 1500);
	    HAL_Delay(500);

	    // Slow forward
	    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 1600);
	    HAL_Delay(1000);

	    // Stop
	    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 1500);
	    HAL_Delay(500);

	/* USER CODE END WHILE */
	}
	}
